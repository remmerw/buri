package io.github.remmerw.buri


import kotlinx.io.Sink

class BEWriter(val sink: Sink){
    fun eof(){
        sink.writeByte(EOF.code.toByte())
    }
   
    fun map(){
        sink.writeByte(MAP_PREFIX.code.toByte())
    }
   
    fun list(){
        sink.writeByte(LIST_PREFIX.code.toByte())
    }
}